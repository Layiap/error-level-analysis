%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Definitionen mit Ausgabe im Index
% gibt #2 aus und f�gt #1 bzw. #2 (wenn #1 nicht angegeben) in den Index ein
\newcommand{\Def}[2][]{%
   \def\OPTARG{#1}%
   \def\EMPTY{}%
   \ifx\OPTARG\EMPTY\index{#2}\else\index{#1}\fi%
   \textbf{#2}\xspace%
}

